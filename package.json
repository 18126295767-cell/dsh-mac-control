{
  "name": "dsh-mac-control",
  "version": "0.1.0",
  "description": "Local browser and macOS desktop controls for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/18126295767-cell/dsh-mac-control.git"
  },
  "bugs": {
    "url": "https://github.com/18126295767-cell/dsh-mac-control/issues"
  },
  "homepage": "https://github.com/18126295767-cell/dsh-mac-control#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "macos",
    "browser-automation",
    "desktop-automation",
    "safari",
    "google-chrome"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "demo:record": "node scripts/capture-demo-gif.mjs",
